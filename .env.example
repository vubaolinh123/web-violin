# Public address of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://stradplus.com

# Contact form delivery (SMTP). Without SMTP_HOST the form tells visitors to write by email instead.
# OxMail (iNET): mail.oxmail.vn has a valid certificate; mail.stradplus.com points to it.
SMTP_HOST=mail.oxmail.vn
SMTP_PORT=587
SMTP_USER=contact@stradplus.com
SMTP_PASS=
# The sender must be the mailbox above (the plan has a single mailbox).
CONTACT_FROM=Strad Plus Website <contact@stradplus.com>
CONTACT_TO=contact@stradplus.com

# Optional: shared anti-spam limit on Vercel. Added automatically when an "Upstash for Redis" store
# is connected to the project from the Vercel Marketplace; without them the limit is kept in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
