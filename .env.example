# Public address of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://stradplus.com

# Contact form delivery (SMTP). Without SMTP_HOST the form tells visitors to write by email instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=Strad Plus Website <no-reply@stradplus.com>
CONTACT_TO=contact@stradplus.com
